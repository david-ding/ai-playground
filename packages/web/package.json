{
  "name": "@ai-playground/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:brand-b": "VITE_BRAND=brand-b yarn build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "vr:build": "node vr-tests/build.mjs",
    "vr:test": "node vr-tests/build.mjs && playwright test --config vr-tests/playwright.config.ts",
    "vr:update": "node vr-tests/build.mjs && playwright test --config vr-tests/playwright.config.ts --update-snapshots"
  },
  "dependencies": {
    "@david-ding/brand-theme": "0.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-dropzone": "19.1.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "oxlint": "1.71.0",
    "typescript": "7.0.2"
  }
}
